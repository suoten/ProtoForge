{
  "id": "opcua_temperature_sensor",
  "name": "温度传感器",
  "protocol": "opcua",
  "description": "工业温度传感器，支持多点温度监测和报警",
  "manufacturer": "Generic",
  "model": "TS-100",
  "points": [
    {
      "name": "temperature",
      "address": "ns=2;s=Temperature",
      "data_type": "float32",
      "unit": "C",
      "description": "当前温度值",
      "access": "rw",
      "generator_type": "sine",
      "min_value": -40.0,
      "max_value": 125.0,
      "generator_config": {
        "period": 10.0
      }
    },
    {
      "name": "humidity",
      "address": "ns=2;s=Humidity",
      "data_type": "float32",
      "unit": "%RH",
      "description": "环境湿度",
      "access": "r",
      "generator_type": "random",
      "min_value": 0.0,
      "max_value": 100.0
    },
    {
      "name": "alarm_high",
      "address": "ns=2;s=AlarmHigh",
      "data_type": "bool",
      "description": "高温报警",
      "access": "rw",
      "generator_type": "fixed",
      "fixed_value": false
    },
    {
      "name": "alarm_low",
      "address": "ns=2;s=AlarmLow",
      "data_type": "bool",
      "description": "低温报警",
      "access": "rw",
      "generator_type": "fixed",
      "fixed_value": false
    },
    {
      "name": "setpoint",
      "address": "ns=2;s=Setpoint",
      "data_type": "float32",
      "unit": "C",
      "description": "温度设定值",
      "access": "rw",
      "generator_type": "fixed",
      "fixed_value": 25.0
    }
  ],
  "protocol_config": {
    "security_mode": "None",
    "security_policy": "None",
    "certificate_path": "",
    "private_key_path": ""
  },
  "tags": [
    "工业安全",
    "温度",
    "报警"
  ]
}