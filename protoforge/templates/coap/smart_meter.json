    {"name": "current", "address": "meter/current", "data_type": "float32", "unit": "A", "description": "电流", "access": "rw", "generator_type": "sine", "generator_config": {"min": 1, "max": 15, "frequency": 0.001, "noise": 0.2}, "min_value": 0, "max_value": 100},
    {"name": "active_power", "address": "meter/active_power", "data_type": "float32", "unit": "W", "description": "有功功率", "access": "rw", "generator_type": "sine", "generator_config": {"min": 200, "max": 3300, "frequency": 0.001, "noise": 10}, "min_value": 0, "max_value": 10000},
    {"name": "power_factor", "address": "meter/power_factor", "data_type": "float32", "unit": "", "description": "功率因数", "access": "rw", "generator_type": "random_walk", "generator_config": {"min": 0.92, "max": 0.99, "step_size": 0.005}, "min_value": 0, "max_value": 1},
    {"name": "total_energy", "address": "meter/total_energy", "data_type": "float32", "unit": "kWh", "description": "总电量", "access": "rw", "generator_type": "increment", "generator_config": {"min": 0, "max": 999999, "step": 0.001, "frequency": 0.1}, "min_value": 0, "max_value": 9999999},
    {"name": "frequency", "address": "meter/frequency", "data_type": "float32", "unit": "Hz", "description": "频率", "access": "rw", "generator_type": "random_walk", "generator_config": {"min": 49.95, "max": 50.05, "step_size": 0.005}, "min_value": 47, "max_value": 53}
  ]
