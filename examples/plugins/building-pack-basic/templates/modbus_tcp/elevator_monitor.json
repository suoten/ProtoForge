      "generator_config": {}
    },
    {
      "name": "trapped_alarm",
      "address": "10",
      "data_type": "bool",
      "unit": "",
      "access": "r",
      "generator_type": "fixed",
      "fixed_value": false,
      "description": "困人告警",
      "generator_config": {}
    },
    {
      "name": "maintenance_mode",
      "address": "11",
      "data_type": "bool",
      "unit": "",
      "access": "rw",
      "generator_type": "fixed",
      "fixed_value": false,
      "description": "维保模式（远程可写）",
      "generator_config": {}
    },
    {
      "name": "floor_lock",
      "address": "12",
      "data_type": "bool",
      "unit": "",
      "access": "rw",
      "generator_type": "fixed",
      "fixed_value": false,
