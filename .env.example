# ============================================
# ProtoForge Core Configuration
# ============================================
# NOTE: Keep this file ASCII-only. It is read as UTF-8; if an editor or
# cleaner tool re-encodes it (e.g. GBK), the server fails to start.
# Chinese docs: see README.md / docs/

# Web service listen address and port
PROTOFORGE_HOST=0.0.0.0
PROTOFORGE_PORT=8000

# Database
# SQLite (default, for dev / single-machine deployment):
PROTOFORGE_DB_PATH=data/protoforge.db
# PostgreSQL (recommended for production):
# Format: postgresql://user:password@host:port/dbname?sslmode=require
# Inject credentials via environment variables or Docker Secrets, never hardcode
# When using Docker Compose, set the full PROTOFORGE_DB_PATH in .env
# Example: PROTOFORGE_DB_PATH=postgresql://protoforge:yourpassword@postgres:5432/protoforge
# PROTOFORGE_DB_PATH=postgresql://USER:PASS@localhost:5432/protoforge?sslmode=require
# Docker Compose PostgreSQL test database URL
# PROTOFORGE_DB_PATH_TEST=postgresql://protoforge:yourpassword@postgres:5432/protoforge_test
# Docker Compose PostgreSQL password (required when using PostgreSQL):
PROTOFORGE_DB_PASSWORD=

# JWT secret (IMPORTANT: change in production!)
# Leave empty to auto-generate a random secret on first start, but all tokens
# become invalid after restart (causing 401 errors)
# For production set a random string of 32+ bytes: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROTOFORGE_JWT_SECRET=protoforge_change_this_jwt_secret_in_production_2026

# Demo mode (auto-create sample devices on startup)
PROTOFORGE_DEMO_MODE=false

# Log level: debug, info, warning, error
PROTOFORGE_LOG_LEVEL=info

# CORS allowed origins (comma separated)
# For production set explicit domains, e.g.: https://protoforge.example.com
PROTOFORGE_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Disable authentication (dev/test ONLY, never enable in production)
# PROTOFORGE_NO_AUTH=false

# Initial admin password (default: admin; set a strong password in production!)
PROTOFORGE_ADMIN_PASSWORD=admin

# Reset admin password (when true, startup overwrites the admin password in DB
# with the value of PROTOFORGE_ADMIN_PASSWORD)
# Set back to false after changing the password to avoid resetting on every restart
PROTOFORGE_RESET_ADMIN_PASSWORD=false

# Minimum password length (default: 4, recommend 8+ for production)
PROTOFORGE_MIN_PASSWORD_LENGTH=8

# Token lifetime (seconds)
# PROTOFORGE_ACCESS_TOKEN_EXPIRES=86400
# PROTOFORGE_REFRESH_TOKEN_EXPIRES=604800

# Login security policy
# PROTOFORGE_MAX_LOGIN_ATTEMPTS=5
# PROTOFORGE_LOCKOUT_DURATION=300

# ============================================
# InfluxDB data forwarding (optional)
# ============================================
# PROTOFORGE_INFLUXDB_URL=http://localhost:8086
# PROTOFORGE_INFLUXDB_TOKEN=your-influxdb-token
# PROTOFORGE_INFLUXDB_ORG=default
# PROTOFORGE_INFLUXDB_BUCKET=protoforge

# ============================================
# EdgeLite gateway integration (optional)
# ============================================
# PROTOFORGE_EDGELITE_URL=http://localhost:8080
# PROTOFORGE_EDGELITE_USERNAME=admin
# PROTOFORGE_EDGELITE_PASSWORD=

# ============================================
# Protocol ports
# ============================================

PROTOFORGE_MODBUS_TCP_PORT=5020
# PROTOFORGE_MODBUS_RTU_PORT=  (leave empty to auto-detect: Windows=COM1, Linux=/dev/ttyUSB0)
PROTOFORGE_OPCUA_PORT=4840
PROTOFORGE_MQTT_PORT=1883
PROTOFORGE_HTTP_PORT=8080
PROTOFORGE_GB28181_PORT=5060
PROTOFORGE_BACNET_PORT=47808
PROTOFORGE_S7_PORT=102
PROTOFORGE_MC_PORT=5000
PROTOFORGE_FINS_PORT=9600
PROTOFORGE_AB_PORT=44818
PROTOFORGE_OPCDA_PORT=51340
PROTOFORGE_FANUC_PORT=8193
PROTOFORGE_MTCONNECT_PORT=7878
PROTOFORGE_TOLEDO_PORT=1701
PROTOFORGE_PROFINET_PORT=34964
PROTOFORGE_ETHERCAT_PORT=34980

# ============================================
# High availability / failover (optional)
# ============================================
# PROTOFORGE_FAILOVER_ROLE=primary
# PROTOFORGE_FAILOVER_PRIMARY=http://localhost:8000
# PROTOFORGE_FAILOVER_STANDBY=http://localhost:8001
# PROTOFORGE_FAILOVER_INTERVAL=10

# ============================================
# gRPC service (optional, disabled by default)
# Set to 0 to disable, or a port number (e.g. 50051) to enable
# ============================================
PROTOFORGE_GRPC_PORT=0

# ============================================
# API rate limiting
# ============================================
# PROTOFORGE_RATE_LIMIT_MAX_REQUESTS=100
# PROTOFORGE_RATE_LIMIT_WINDOW_SECONDS=60
# PROTOFORGE_RATE_LIMIT_AUTH_MAX_REQUESTS=10
# PROTOFORGE_RATE_LIMIT_AUTH_WINDOW_SECONDS=60
